import time
import winsound

audio = r"C:\Users\andro\Downloads\Connor_Price_Lucca_DL_-_False_Alarm_Instrumental.wav"  #Connor Price & Luca DL False
# Alarm Instrumental

print("Welcome to set counter.")
def set_counter():
    time.sleep(3)
    exercise = str(input("What is your exercise: ", ))
    sets = int(input("How many sets: ", ))
    break_time = int(input("How many seconds do you want: ", ))
    sets_missing = int(input("Enter the current set: ", ))
    while sets - sets_missing != 0:
        if sets < sets_missing:
            return "Over the limit."
        else:
            print(f"The {exercise} is/are missing {sets - sets_missing} set(s).")
            time.sleep(1)
            print("Break")
            time.sleep(break_time)
            start_time = time.time()
            end_time = time.time()
            if start_time - end_time <= 0:
                winsound.PlaySound(audio, winsound.SND_ASYNC)
                stop = input("Enter 'stop' to stop the music: ", )
                while stop != "stop":
                    winsound.PlaySound(audio, winsound.SND_ASYNC)
                    stop = input("Enter 'stop' to stop the music: ", )
                if stop == "stop":
                        winsound.PlaySound(None, winsound.SND_ASYNC)
            sets_missing = int(input("Enter the current set. ", ))
    return f"The {exercise} has/have been completed."

print(set_counter())
