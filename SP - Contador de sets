import time
import winsound

audio = r"C:\Users\andro\Downloads\Connor_Price_Lucca_DL_-_False_Alarm_Instrumental.wav"  #Connor Price & Luca DL False
# Alarm Instrumental

print("Bienvenido a contador de sets.")
def contador_de_sets():
    time.sleep(3)
    ejercicio = str(input("Cuál es tu ejercicio? ", ))
    sets = int(input("Cuántos sets seran? ", ))
    tiempo_de_descanso = int(input("Cuántos segundos de descanso tu quieres? ", ))
    sets_que_faltan = int(input("Pon el numero de set que vas. ", ))
    while sets - sets_que_faltan != 0:
        if sets < sets_que_faltan:
            return "Sobre el limite."
        else:
            print(f"El/Los {ejercicio} le falta(n) {sets - sets_que_faltan} set(s).")
            time.sleep(1)
            print("Descanso.")
            time.sleep(tiempo_de_descanso)
            tiempo_de_empezar = time.time()
            tiempo_de_terminar = time.time()
            if tiempo_de_empezar - tiempo_de_terminar <= 0:
                winsound.PlaySound(audio, winsound.SND_ASYNC)
                parar = input("Pon 'parar' para parar la musica: ", )
                while parar != "parar":
                    winsound.PlaySound(audio, winsound.SND_ASYNC)
                    parar = input("Pon 'parar' para parar la musica: ", )
                    if parar == "parar":
                        winsound.PlaySound(None, winsound.SND_PURGE)
            sets_que_faltan = int(input("Pon el numero de set que vas. ", ))
    return f"El/Los {ejercicio} se ha(n) completado."

print(contador_de_sets())
